# Copy this file to `.env` and fill in your values.
# NOTE: many MCP clients do not auto-load `.env`. Set these in your client's
# `env` block instead (see mcp.example.json).

# --- Facebook session cookies (required) ---
# Path to cookies exported as JSON from your browser (Cookie-Editor etc.).
FACEBOOK_COOKIES_FILE=facebook_cookies.json

# --- Geonode proxy (optional but recommended) ---
# Easiest: paste the full proxy URL from Geonode's dashboard.
# Format: http://USERNAME:PASSWORD@HOST:PORT   (port 9000 = rotating HTTP/HTTPS)
GEONODE_PROXY_URL=

# --- OR build it from parts (used only if GEONODE_PROXY_URL is empty) ---
# GEONODE_PROXY_USERNAME=your_geonode_username
# GEONODE_PROXY_PASSWORD=your_geonode_password
# GEONODE_PROXY_HOST=your-proxy-host.example.com
# GEONODE_PROXY_PORT=9000

# --- Optional overrides ---
# FACEBOOK_STATE_FILE=facebook_state.json
# FB_USER_AGENT=
# FB_DEFAULT_LATITUDE=40.7128      # default search centre (NYC)
# FB_DEFAULT_LONGITUDE=-74.0060
# FB_REQUEST_TIMEOUT=30            # seconds per HTTP request
# FB_CURRENCY=USD                 # preferred currency for ambiguous symbols like $
